   "source": [
    "# Esto es crucial para que GLM las trate como variables dummy automáticamente.\n",
    "categorical_cols = [\"month\", \"type\", \"rooms\", \"ownership\", \"buildingmaterial\"]\n",
    "for col in categorical_cols\n",
    "    # Asegurarse de que la columna exista\n",
    "    if col in names(df) # <-- CAMBIAR 'data' por 'df' aquí\n",
    "        df[!, col] = categorical(df[!, col]) # <-- CAMBIAR 'data' por 'df' aquí\n",
    "    end\n",
    "end\n",
